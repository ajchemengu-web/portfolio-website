# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy this file to ".env" for local development and NEVER commit the real
# ".env" file to version control (it is already in .gitignore).
# In production (Railway) set these as project environment variables instead
# of shipping a .env file.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_APP=wsgi.py
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_SECRET_KEY=change-me-to-a-different-long-random-value

# Database (Supabase Postgres connection string, "Session pooler" recommended)
# Example: postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///dev.db

# Supabase project (used for Storage; DB access goes through DATABASE_URL above)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=portfolio-files

# Single administrator account (used by scripts/seed_admin.py)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=set-a-strong-password-then-rotate-it

# CORS — comma separated list of allowed origins for the Flutter web frontend
ALLOWED_ORIGINS=http://localhost:5000,https://your-frontend-domain.example

# Rate limiting storage (use redis:// in production; memory:// only for local dev)
RATELIMIT_STORAGE_URI=memory://

# Optional: force HTTPS + HSTS (enable in production behind Railway's TLS)
FORCE_HTTPS=false

# File upload limits
MAX_CONTENT_LENGTH_MB=25
